# Copy to backend/.env and adjust. All variables are optional.

# Where weights, uploads, outputs and the SQLite database are stored.
# YVS_STORAGE_DIR=./storage

# Comma separated list of origins allowed to call the API (CORS and WebSocket).
YVS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Upload limits in megabytes.
YVS_MAX_MODEL_SIZE_MB=512
YVS_MAX_IMAGE_SIZE_MB=25
YVS_MAX_VIDEO_SIZE_MB=1024

# Inspect checkpoint pickles before loading them (recommended). Only disable
# for files you fully trust.
YVS_MODEL_SECURITY_SCAN=true

# Number of models kept in memory, and whether to reload the last active
# model when the server starts.
YVS_MAX_LOADED_MODELS=2
YVS_AUTOLOAD_LAST_MODEL=true

# Set to false to never use a GPU even if CUDA is available.
YVS_ALLOW_CUDA=true

# Inference limits.
YVS_INFERENCE_TIMEOUT_S=120
YVS_MAX_CONCURRENT_VIDEO_JOBS=1
YVS_VIDEO_JOB_TIMEOUT_S=21600

# Serve a built frontend from the API origin (production, optional).
# YVS_FRONTEND_DIST_DIR=../frontend/dist

YVS_LOG_LEVEL=INFO
